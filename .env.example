# Server
PORT=5000
NODE_ENV=development

# MySQL connection. When omitted, the API uses in-memory data.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=creative_studio

DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# CORS origin for the frontend in development
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=/api

# Private S3 attachment storage. Authentication comes from AWS CLI credentials or an IAM role.
AWS_REGION=ap-southeast-2
S3_BUCKET=creatign-2026  
